---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="tech-stack-section">
  {/* ══ CONSOLE BACKGROUND LAYERS ══ */}
  <div class="console-grid"></div>
  <div class="particle-diffusion"></div>
  
  <div class="container relative">
    <div class="section-header text-center">
      <span class="tech-tag animate-reveal">{eyebrow}</span>
      <h2 class="section-title animate-reveal">{title}</h2>
      <p class="body-text animate-reveal">{intro}</p>
      
      <div class="robotic-anchor">
        <slot name="robotic-visual" />
      </div>
    </div>

    <div class="tech-grid">
      <slot />
    </div>
  </div>
</section>

<style>
  .tech-stack-section {
    position: relative;
    padding: 120px 0 160px;
    background: #000;
    overflow: hidden;
    z-index: 0;
  }

  /* ══ Z-0: CONSOLE ALIGNMENT GRID ══ */
  .console-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(0, 255, 255, 0.06) 1px, transparent 0);
    background-size: 48px 48px;
    opacity: 0.03;
    z-index: 1;
    pointer-events: none;
  }

  /* ══ Z-1: PARTICLE DIFFUSION ══ */
  .particle-diffusion {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 20% 30%, rgba(0, 255, 255, 0.04), transparent 60%),
      radial-gradient(circle at 80% 70%, rgba(0, 255, 255, 0.03), transparent 60%);
    z-index: 2;
    pointer-events: none;
  }

  .container {
    position: relative;
    z-index: 4; /* Above background layers */
  }

  .section-header {
     max-width: 800px;
     margin: 0 auto 80px;
     position: relative;
  }

  .tech-tag {
    display: block;
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--secondary);
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .section-title {
    font-size: 3.5rem;
    color: #fff;
    margin-bottom: 20px;
  }

  .body-text {
    font-size: 1.25rem;
    color: var(--text-muted);
    line-height: 1.5;
    opacity: 0.8;
  }

  /* ══ ROBOTIC ANCHOR SVG POSITIONING ══ */
  .robotic-anchor {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 3;
    pointer-events: none;
    opacity: 0.4;
  }

  /* ══ 4-COLUMN CONSOLE GRID ══ */
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    position: relative;
    z-index: 5;
  }

  @media (max-width: 1100px) {
    .tech-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .section-title { font-size: 2.5rem; }
  }

  @media (max-width: 640px) {
    .tech-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
