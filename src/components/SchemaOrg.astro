---
const { type, data, slug } = Astro.props;

const DOMAIN = "https://www.precisionortho.care";

let schema = {};

if (type === 'division') {
  schema = {
    "@context": "https://schema.org",
    "@type": "MedicalOrganization",
    "name": `Precision Orthopaedics – ${data.h1}`,
    "url": `${DOMAIN}/clinical-divisions/${slug}`,
    "logo": `${DOMAIN}/favicon.svg`,
    "medicalSpecialty": "Orthopedic Surgery",
    "description": data.clinicalPhilosophy,
    "recognizingAuthority": {
      "@type": "MedicalOrganization",
      "name": "Precision Surgical Board"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": data.h1,
      "itemListElement": data.programs?.map((prog, idx) => ({
        "@type": "Offer",
        "itemOffered": {
          "@type": "MedicalSpecialty",
          "name": prog.name,
          "description": prog.doctrine
        },
        "position": idx + 1
      }))
    }
  };
} else if (type === 'treatment') {
  schema = {
    "@context": "https://schema.org",
    "@type": "MedicalProcedure",
    "name": data.title,
    "description": data.subtitle,
    "url": `${DOMAIN}/procedures/${slug}`,
    "medicalSpecialty": "Orthopedic Surgery",
    "relevantSpecialty": {
      "@type": "MedicalSpecialty",
      "name": data.category
    },
    "bodyLocation": data.parentDivision?.replace('-', ' ') || "Joint",
    "procedureType": {
      "@type": "MedicalProcedureType",
      "name": data.parentProgram
    },
    "outcome": {
      "@type": "MedicalEntity",
      "name": "Precision Recovery Benchmark",
      "description": `Goal: ${data.stats?.accuracy} mapping accuracy and ${data.stats?.recovery} recovery.`
    }
  };
} else if (type === 'clinic') {
  schema = {
    "@context": "https://schema.org",
    "@type": "MedicalClinic",
    "name": data.name,
    "url": `${DOMAIN}/locations`,
    "logo": `${DOMAIN}/favicon.svg`,
    "telephone": data.coordination,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": data.address,
      "addressLocality": "Hyderabad",
      "addressRegion": "Telangana",
      "postalCode": "500032",
      "addressCountry": "IN"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "17.416547",
      "longitude": "78.352063"
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "09:00",
      "closes": "17:00"
    },
    "medicalSpecialty": ["OrthopedicSurgery", "SportsMedicine"]
  };
} else if (type === 'physician') {
  schema = {
    "@context": "https://schema.org",
    "@type": "Physician",
    "name": data.name,
    "image": `${DOMAIN}${data.image}`,
    "medicalSpecialty": data.specialty,
    "telephone": data.appointmentLink ? undefined : "+917842932051",
    "url": `${DOMAIN}/doctor/${slug}`,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Financial District, Gachibowli",
      "addressLocality": "Hyderabad",
      "addressRegion": "Telangana",
      "postalCode": "500032",
      "addressCountry": "IN"
    }
  };
} else if (type === 'organization') {
  schema = {
    "@context": "https://schema.org",
    "@type": "MedicalOrganization",
    "name": "Precision Orthopaedics",
    "url": DOMAIN,
    "logo": `${DOMAIN}/favicon.svg`,
    "description": "Engineering Excellence in Musculoskeletal Restoration. UK-trained HOD leadership and robotic surgical board oversight.",
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+91-78429-32051",
      "contactType": "Precison Coordination Hub",
      "areaServed": "IN",
      "availableLanguage": ["English", "Hindi", "Telugu"]
    }
  };
}

// Add FAQPage Schema for rich snippets (AIO Optimization)
let faqSchema = null;
if (type === 'treatment' && data.faqs && data.faqs.length > 0) {
  faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": data.faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  };
}

// Add BreadcrumbList
const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `${DOMAIN}/`
    }
  ]
};

if (type === 'division') {
  breadcrumbs.itemListElement.push({
    "@type": "ListItem",
    "position": 2,
    "name": data.h1,
    "item": `${DOMAIN}/clinical-divisions/${slug}`
  });
} else if (type === 'treatment') {
  breadcrumbs.itemListElement.push({
    "@type": "ListItem",
    "position": 2,
    "name": "Procedures",
    "item": `${DOMAIN}/procedures`
  });
  breadcrumbs.itemListElement.push({
    "@type": "ListItem",
    "position": 3,
    "name": data.title,
    "item": `${DOMAIN}/procedures/${slug}`
  });
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
