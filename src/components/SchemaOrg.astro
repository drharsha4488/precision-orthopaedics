---
const { type, data, slug } = Astro.props;

let schema = {};

if (type === 'division') {
  schema = {
    "@context": "https://schema.org",
    "@type": "MedicalOrganization",
    "name": `Precision Orthopaedics – ${data.h1}`,
    "medicalSpecialty": "Orthopedic Surgery",
    "description": data.clinicalPhilosophy,
    "url": `https://precisionorthopaedics.com/clinical-divisions/${slug}`,
    "logo": "https://precisionorthopaedics.com/logo.png",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": data.h1,
      "itemListElement": data.programs.map((prog, idx) => ({
        "@type": "Offer",
        "itemOffered": {
          "@type": "MedicalSpecialties",
          "name": prog.name,
          "description": prog.doctrine
        },
        "position": idx + 1
      }))
    }
  };
} else if (type === 'treatment') {
  schema = {
    "@context": "https://schema.org",
    "@type": "MedicalProcedure",
    "name": data.title,
    "description": data.subtitle,
    "medicalSpecialty": "Orthopedic Surgery",
    "relevantSpecialty": {
      "@type": "MedicalSpecialty",
      "name": data.category
    },
    "bodyLocation": data.parentDivision.replace('-', ' '),
    "procedureType": {
      "@type": "MedicalProcedureType",
      "name": data.parentProgram
    }
  };
}

// Add BreadcrumbList
const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://precisionorthopaedics.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Clinical Divisions",
      "item": "https://precisionorthopaedics.com/#divisions"
    }
  ]
};

if (type === 'division') {
  breadcrumbs.itemListElement.push({
    "@type": "ListItem",
    "position": 3,
    "name": data.h1,
    "item": `https://precisionorthopaedics.com/clinical-divisions/${slug}`
  });
} else if (type === 'treatment') {
  breadcrumbs.itemListElement.push({
    "@type": "ListItem",
    "position": 3,
    "name": data.category,
    "item": `https://precisionorthopaedics.com/clinical-divisions/${data.parentDivision}`
  });
  breadcrumbs.itemListElement.push({
    "@type": "ListItem",
    "position": 4,
    "name": data.title,
    "item": `https://precisionorthopaedics.com/specialities/${slug}`
  });
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
