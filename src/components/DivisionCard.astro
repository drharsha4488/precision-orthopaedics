---
import { Activity, Layers, Zap, Target, ArrowRight } from 'lucide-react';

interface Props {
  title: string;
  description: string;
  scope: string; // "Robotic Knee Replacement · Revision Arthroplasty · Joint Preservation"
  doctors: string[];
  image: string;
  href: string;
  iconName: "activity" | "layers" | "zap" | "target";
  highlight?: boolean;
}

const { title, description, scope, doctors, image, href, iconName, highlight } = Astro.props;

const IconMap = {
  activity: Activity,
  layers: Layers,
  zap: Zap,
  target: Target,
};

const Icon = IconMap[iconName];
---

<a href={href} class={`division-card ${highlight ? 'highlight' : ''}`}>
  <div class="division-bg">
    {image && <img decoding="async" width="1024" height="1024" src={image} alt="" loading="lazy" />}
  </div>

  <div class="division-content">
    <div class="division-icon-row">
       {Icon && <Icon size={18} strokeWidth={1.5} class="division-glyph" />}
    </div>

    <h3>{title}</h3>
    <p class="division-subtitle">{description}</p>
    
    <p class="division-scope">{scope}</p>

    <div class="division-footer">
       <div class="doctor-leads">
          <span class="doctor-pill-label">Program Leads</span>
          <div class="doctor-pill-strip">
             {doctors.map((doc, i) => (
                <>
                  <span class="doctor-name">{doc}</span>
                  {i < doctors.length - 1 && <span class="dot">·</span>}
                </>
             ))}
          </div>
       </div>
       <div class="division-arrow">
          <ArrowRight size={16} />
       </div>
    </div>
  </div>
</a>

<style>
  .division-card {
    position: relative;
    padding: 32px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(0, 255, 255, 0.08);
    overflow: hidden;
    text-decoration: none;
    transition: all 400ms cubic-bezier(0.2, 0.8, 0.2, 1);
    display: flex;
    flex-direction: column;
    min-height: 280px;
  }

  .division-card.highlight {
    border-color: rgba(0, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.03);
  }

  .division-card:hover {
    transform: translateY(-8px);
    border-color: rgba(0, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }

  .division-bg {
    position: absolute;
    top: -5%;
    right: -5%;
    width: 60%;
    height: 80%;
    z-index: 0;
    pointer-events: none;
  }

  .division-bg img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.05;
    filter: grayscale(1) brightness(1.5) blur(1px);
    transform: scale(1.2);
    transition: all 0.6s ease;
  }

  .division-card:hover .division-bg img {
    transform: scale(1.1) rotate(5deg);
    opacity: 0.08;
  }

  .division-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .division-icon-row {
    margin-bottom: 20px;
    color: var(--secondary);
    opacity: 0.65;
  }

  .division-card h3 {
    font-size: 1.4rem;
    color: #fff;
    margin-bottom: 8px;
    line-height: 1.2;
  }

  .division-subtitle {
    font-size: 0.95rem;
    color: var(--secondary);
    font-weight: 500;
    margin-bottom: 12px;
  }

  .division-scope {
    font-size: 12px;
    color: var(--text-muted);
    opacity: 0.55;
    line-height: 1.4;
    margin-bottom: auto;
  }

  .division-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .doctor-pill-label {
    display: block;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    opacity: 0.5;
    margin-bottom: 6px;
  }

  .doctor-pill-strip {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
  }

  .dot {
    color: var(--secondary);
    opacity: 0.5;
  }

  .division-arrow {
    color: var(--secondary);
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.3s ease;
  }

  .division-card:hover .division-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 768px) {
    .division-card:hover {
      transform: none;
    }
  }
</style>
