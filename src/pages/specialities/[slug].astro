---
import Layout from '../../layouts/Layout.astro';
import { Activity, Beaker, CheckCircle, Clock, Crosshair, ArrowRight, ActivitySquare, UserCheck, BarChart3, Upload, Syringe, MessageCircle, ChevronRight, Video, HelpCircle, IndianRupee, Cpu, ShieldCheck, PlayCircle, Shield, Target } from 'lucide-react';
import { treatmentData } from '../../services/treatmentData';
import { divisions } from '../../services/divisionData';
import RadiologySlider from '../../components/RadiologySlider';
import CandidateTriage from '../../components/CandidateTriage';
import RecoveryChart from '../../components/RecoveryChart';
import SchemaOrg from '../../components/SchemaOrg.astro';
import '../TreatmentTemplate.css';

export async function getStaticPaths() {
  return Object.keys(treatmentData).map((slug) => ({
    params: { slug },
    props: { data: treatmentData[slug] },
  }));
}

const { data } = Astro.props;
const { slug } = Astro.params;

// Inherit Parent Program Logic
const parentDiv = divisions[data.parentDivision];
const parentProg = parentDiv.programs.find(p => p.id === data.parentProgram);
---

<Layout title={data.title} description={data.subtitle}>
  <SchemaOrg type="treatment" data={data} slug={slug} />

  <div class="treatment-page">
    {/* ══ INSTITUTIONAL HIERARCHY STRIP ══ */}
    <section class="institutional-hierarchy-strip bg-dark-alt">
       <div class="container hierarchy-flex">
          <div class="h-parent">
             <a href={`/clinical-divisions/${data.parentDivision}`}>{parentDiv.h1}</a>
             <ChevronRight size={14} />
             <span>{parentProg.name}</span>
          </div>
          <div class="h-ladder">
             {parentDiv.pathwayLogic.steps.map((step, idx) => (
               <div class={`h-step ${step.label.toLowerCase().includes(data.parentProgram) ? 'active' : ''}`} style={`--step-color: ${step.color}`}>
                  <span class="h-idx">{idx + 1}</span>
                  <span class="h-lab">{step.label}</span>
               </div>
             ))}
          </div>
       </div>
    </section>

    {/* ══ SECTION 1: CINEMATIC HERO ══ */}
    <section id="hero" class="treatment-hero animate-reveal">
      <div class="hero-grid container">
        <div class="hero-text">
          <div class="institutional-marker"><Shield size={14}/> Precision Surgical Board Governance</div>
          <span class="category-badge">{data.category}</span>
          <h1>{data.title}</h1>
          <p class="subtitle">{data.subtitle}</p>
          <div class="hero-stats">
            <div class="stat-pill"><Activity size={16}/> {data.stats.volume} Procedures</div>
            <div class="stat-pill"><Crosshair size={16}/> {data.stats.accuracy} Precision</div>
            <div class="stat-pill"><Clock size={16}/> {data.stats.recovery} Recovery</div>
          </div>
          <a href="tel:+917842932051" class="btn btn-primary mt-lg">
            Request Board Evaluation <ArrowRight size={16}/>
          </a>
          <p class="cta-subtext mt-sm">Program Coordinator: +91 78429 32051</p>
        </div>
        <div class="hero-visual">
          <div class="video-card border-glow">
            <div class="video-overlay text-center">
              <PlayCircle size={48} class="text-secondary mb-sm" />
              <h3>"The Surgeon's Eye"</h3>
              <p>{data.videoTarget} explains the procedure.</p>
            </div>
          </div>
          <div class="program-theme-card mt-md">
             <span class="theme-tag">Internal Doctrine</span>
             <p>"{data.programTheme}"</p>
          </div>
        </div>
      </div>
    </section>

    {/* ══ PROGRAM OUTCOME EVIDENCE STRIP ══ */}
    <section class="outcome-evidence-bar">
       <div class="container bar-flex">
          <div class="bar-item">
             <Target size={18} class="text-secondary" />
             <span><strong>Precision Strategy:</strong> {parentDiv.outcomeEvidence.strategy}</span>
          </div>
          <div class="bar-item">
             <ShieldCheck size={18} class="text-secondary" />
             <span><strong>Clinical Standard:</strong> {parentDiv.outcomeEvidence.standard}</span>
          </div>
       </div>
    </section>

    {/* ══ SECTION 2: ANATOMY DIAGNOSTIC ══ */}
    <section id="anatomy" class="container section-block">
      <div class="bento-card col-span-full bg-dark-alt">
        <div class="anatomy-layout">
          <div class="anatomy-text">
            <h2><ActivitySquare size={24} class="text-secondary"/> Anatomical Pathology</h2>
            <p class="mt-md body-text">{data.anatomyText}</p>
          </div>
          <div class="anatomy-visualizer">
            <div class="wireframe-mesh">
              <div class="scan-line"></div>
              <Crosshair size={64} class="target-reticle" />
              <p class="mt-sm" style="color: var(--secondary); font-weight: 600">Scanning Kinetic Topography...</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ══ SECTION 3: ELIGIBILITY & SELECTION ══ */}
    <section id="eligibility" class="container section-block">
      <h2 class="section-title text-center">Institutional Candidacy Profile</h2>
      <CandidateTriage client:visible symptoms={data.candidateSymptoms} />

      <div class="bento-grid-institutional mt-xl">
        <div class="bento-card">
           <h3 class="mb-md"><UserCheck size={20} class="text-secondary"/> Ideal Program Candidate</h3>
           <div class="elig-list">
             {data.eligibility.map((e) => (
               <div class="elig-item">
                 <CheckCircle size={18} class="text-secondary" />
                 <span>{e}</span>
               </div>
             ))}
           </div>
        </div>
        <div class="bento-card">
           <h3 class="mb-md"><Activity size={20} class="text-secondary"/> Case Complexity Tier</h3>
           <div class="comp-spectrum-mini">
              {parentDiv.caseComplexity.map(item => (
                <div class="spectrum-node">
                   <div class="s-dot"></div>
                   <div class="s-info">
                      <strong>{item.level}</strong>
                      <span>{item.case}</span>
                   </div>
                </div>
              ))}
           </div>
        </div>
      </div>
    </section>

    {/* ══ SECTION 4: COMPARISON ══ */}
    <section id="comparison" class="container section-block">
      <h2 class="section-title text-center">Program Precision Benchmarks</h2>
      <div class="comparison-table mt-lg bento-card p-0 overflow-hidden dark-glass">
        <div class="comp-header p-xl">
          <span>Feature</span>
          <span>Conventional</span>
          <span class="text-secondary">Precision Robotic System</span>
        </div>
        <div class="comp-rows px-xl pb-xl">
           {data.comparison.map((row) => (
             <div class="comp-row">
               <span class="comp-feature">{row.feature}</span>
               <span class="comp-conventional">{row.conventional}</span>
               <span class="comp-robotic">{row.robotic}</span>
             </div>
           ))}
        </div>
      </div>

      <div class="mt-xl bento-card p-xl bg-dark-alt">
        <h3 class="mb-lg text-center"><BarChart3 size={20} class="text-secondary"/> Kinetic Recovery Analytics</h3>
        <RecoveryChart client:visible data={data.recoveryChart} />
      </div>
    </section>

    {/* ══ SECTION 5: RADIOLOGY SLIDER ══ */}
    <section id="radiology" class="container section-block">
      <h2 class="section-title text-center">Proof of Precision Metrics</h2>
      <RadiologySlider client:load />
    </section>

    {/* ══ SECTION 6: CLINICAL PIPELINE ══ */}
    <section id="pipeline" class="container section-block">
      <div class="timeline-section">
        <h2 class="section-title text-center">Institutional Surgical Pipeline</h2>
        <div class="timeline-track mt-lg">
          {data.timeline.map((step) => (
            <div class="timeline-node">
              <div class="node-marker"><CheckCircle size={20}/></div>
              <div class="node-content">
                <h4>{step.day}</h4>
                <p class="node-action">{step.action}</p>
                <p class="node-detail">{step.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ══ SECTION 7: COST & GOVERNANCE ══ */}
    <section id="cost" class="container section-block">
      <div class="bento-grid-institutional">
         <div class="cost-anchor-card bento-card p-xl">
           <div class="cost-top">
             <IndianRupee size={32} class="text-secondary"/>
             <div>
               <h2>Fee Transparency</h2>
               <p class="body-text">Total institutional package pricing.</p>
             </div>
           </div>
           <div class="cost-range-display mt-lg">
             <span class="cost-value">{data.costRange}</span>
             <span class="cost-note">{data.costNote}</span>
           </div>
         </div>
         <div class="bento-card p-xl bg-dark-alt">
            <ShieldCheck size={32} class="text-secondary mb-sm"/>
            <h3>Surgical Board Oversight</h3>
            <p class="text-muted">This procedure is strictly governed by our multi-fellowship board protocol.</p>
         </div>
      </div>
    </section>

    {/* ══ SECTION 8: TRUST MATRIX ══ */}
    <section id="trust" class="container section-block">
      <div class="bento-grid mt-lg">
        <div class="bento-card col-span-2">
          <ShieldCheck size={32} class="text-secondary mb-sm"/>
          <h3>Infection Prevention Protocol</h3>
          <div class="safety-list mt-md">
            {data.infectionSafety.map((s) => (
              <div class="safety-item"><Syringe size={14}/> {s}</div>
            ))}
          </div>
        </div>

        <div class="bento-card">
          <Upload size={28} class="text-secondary mb-sm"/>
          <h3>Board Evaluation Workflow</h3>
          <div class="mri-steps mt-md">
            {data.mriWorkflow.map((s) => (
              <div class="mri-step">
                <div class="mri-step-num">{s.step}</div>
                <div>
                  <strong>{s.title}</strong>
                  <p>{s.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="bento-card col-span-full">
          <h2 class="section-title text-center">Institutional Inquiry Clearing</h2>
          <div class="faq-nuclear-grid">
            {data.faqs.map((f) => (
              <div class="faq-item-premium">
                <div class="faq-header">
                  <h4><HelpCircle size={18} class="text-secondary" /> {f.q}</h4>
                </div>
                <p class="faq-ans">{f.a}</p>
                <div class="faq-footer">
                  <span class="authority-byline">
                    <ShieldCheck size={12} /> Board Verified by <strong>{data.surgeonName}</strong>
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
