---
import Layout from '../../layouts/Layout.astro';
import { conditionData } from '../../services/conditionData';
import { Activity, ShieldCheck, ArrowRight, ActivitySquare, AlertCircle } from 'lucide-react';
import '../../index.css';

export async function getStaticPaths() {
  return Object.keys(conditionData).map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
let data = conditionData[slug];
const isAlias = !!data.aliasOf;
while (data && data.aliasOf) {
  data = conditionData[data.aliasOf];
}

const displayTitle = isAlias 
  ? slug.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ') + ' Treatment'
  : data.title;
---

<Layout 
  title={`${displayTitle} in Hyderabad`} 
  description={data.subtitle}
>
  <div class="condition-page pt-[180px] pb-24">
    <div class="container">
      {/* Hero Section */}
      <div class="text-center mb-16 animate-reveal">
        <div class="institutional-marker inline-flex items-center justify-center mb-6 px-4 py-2 bg-dark-alt border border-light/10 rounded-full text-xs font-semibold tracking-wider text-light/70 uppercase">
          <AlertCircle size={14} class="mr-2 text-secondary" /> Diagnostic Protocol
        </div>
        <h1 class="text-5xl md:text-6xl font-bold text-white mb-6 leading-tight">{displayTitle}</h1>
        <p class="text-xl text-light/70 max-w-[800px] mx-auto leading-relaxed">{data.subtitle}</p>
        
        <div class="mt-10">
          <a href="tel:+917842932051" class="btn btn-primary inline-flex items-center gap-2">
            Schedule Diagnostic Evaluation <ArrowRight size={16}/>
          </a>
        </div>
      </div>

      {/* Grid Layout */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        {/* Main Content */}
        <div class="lg:col-span-8 space-y-8">
          <div class="bento-card bg-dark-alt">
            <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
              <ActivitySquare size={24} class="text-secondary"/> Anatomical Pathology
            </h2>
            <p class="text-light/80 leading-relaxed text-lg">{data.anatomyText}</p>
          </div>

          <div class="bento-card bg-dark-alt">
            <h2 class="text-2xl font-bold text-white mb-6">Common Clinical Presentations</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {data.symptoms.map(symp => (
                <div class="flex items-start gap-3 p-4 rounded-xl bg-dark border border-light/5">
                  <Activity size={18} class="text-secondary mt-1 shrink-0" />
                  <span class="text-light/90">{symp}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* Sidebar */}
        <div class="lg:col-span-4 space-y-8">
          <div class="bento-card bg-dark border-secondary/20 relative overflow-hidden group">
            <div class="absolute inset-0 bg-gradient-to-br from-secondary/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <h3 class="text-xl font-bold text-white mb-2">Recommended Clinical Pathway</h3>
            <p class="text-light/60 text-sm mb-6">Based on precision diagnosis, you may be a candidate for:</p>
            
            <a href={`/procedures/${data.recommendedProcedure}`} class="block p-4 rounded-xl bg-dark-alt border border-light/10 hover:border-secondary/50 transition-all flex items-center justify-between">
              <div>
                <span class="text-xs text-secondary font-semibold uppercase tracking-wider block mb-1">Target Procedure</span>
                <span class="text-white font-medium block">View Protocol details</span>
              </div>
              <ArrowRight size={18} class="text-light/50 group-hover:text-secondary" />
            </a>
          </div>

          <div class="bento-card bg-dark-alt">
            <h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
              <ShieldCheck size={20} class="text-secondary" /> Primary Specialist
            </h3>
            <div class="p-4 rounded-xl bg-dark border border-light/5 text-center">
              <div class="w-16 h-16 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-3">
                <span class="text-xl font-bold text-secondary">{data.specialistName.charAt(0)}</span>
              </div>
              <strong class="text-white block text-lg">{data.specialistName}</strong>
              <span class="text-sm text-light/60">{data.specialistRole}</span>
              <a href="/about" class="mt-4 block text-sm text-secondary hover:text-white transition-colors">View Credentials &rarr;</a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</Layout>
