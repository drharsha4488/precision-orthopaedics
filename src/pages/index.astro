---
import Layout from '../layouts/Layout.astro';
import { ArrowRight, Crosshair, Target, ShieldCheck, PlayCircle, Cpu, Activity, Zap, Shield, Microscope, Layers } from 'lucide-react';
import BackgroundWaves from '../components/BackgroundWaves';
import GlowOrbs from '../components/GlowOrbs';
import PerspectiveGrid from '../components/PerspectiveGrid';
import Magnetic from '../components/Magnetic';
import BlueprintArm from '../components/BlueprintArm';
import TechStackSection from '../components/TechStackSection.astro';
import TechCard from '../components/TechCard.astro';
import RoboticArmSVG from '../components/RoboticArmSVG.jsx';
import DivisionSection from '../components/DivisionSection.astro';
import DivisionCard from '../components/DivisionCard.astro';
import './Home.css';

// We can still use React components inside Astro!
---

<Layout 
  title="Best Orthopedic surgeon in Hyderabad | Robotic Surgery Hub" 
  description="Precision Orthopaedics: Best Orthopedic Hospital in Hyderabad for Robotic Knee Surgery & Sports Medicine. Led by HOD Dr. Deepthi Nandan Reddy. Premium care in Financial District, Gachibowli."
  heroImage="/robotic_surgery_hero_1775752719796.webp"
>
  <div class="home-container">
    <GlowOrbs client:idle />
    <PerspectiveGrid client:idle />
    
    {/* ══ CINEMATIC HERO ══ */}
    <section class="hero-cinematic">
      <img 
        src="/robotic_surgery_hero_1775752719796.webp" 
        class="hero-bg-visual" 
        alt="Precision Robotic Surgery Environment" 
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
      <div class="hero-overlay"></div>
      
      {/* ══ ELITE AMBIENT LAYERS ══ */}
      <div class="hero-nav-grid">
         <div class="hero-axis-marker" style="top: 10%; left: 5%;">0°</div>
         <div class="hero-axis-marker" style="top: 50%; left: 2%;">90° MECHANICAL AXIS</div>
         <div class="hero-axis-marker" style="bottom: 10%; left: 5%;">MARKER_V_01</div>
      </div>

      <div class="hero-ambient-rotation">
         <img src="/anatomical_knee_schematic_1775754592483.webp" class="specialty-visual" alt="Knee Anatomy" />
         <img src="/anatomical_hip_schematic_1775754608460.webp" class="specialty-visual" alt="Hip Implant" />
         <img src="/anatomical_shoulder_schematic_1775754624021.webp" class="specialty-visual" alt="Shoulder Reconstruction" />
         <img src="/robotic-precision-arc.webp" class="specialty-visual" alt="Robotic Planning" />
      </div>

      <div class="signature-arc-container">
         <svg width="800" height="200" viewBox="0 0 800 200" fill="none">
            <path d="M50 180C150 50 650 50 750 180" stroke="url(#cyan-grad)" stroke-width="2" class="signature-arc" />
            <defs>
               <linearGradient id="cyan-grad" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stop-color="var(--secondary)" stop-opacity="0" />
                  <stop offset="50%" stop-color="var(--secondary)" />
                  <stop offset="100%" stop-color="var(--secondary)" stop-opacity="0" />
               </linearGradient>
            </defs>
         </svg>
      </div>

      <div class="hero-particles"></div>
      <div class="editorial-text">PRECISION</div>
      
      <div class="container hero-content animate-reveal">
        <div class="elite-badge">
          <span class="live-dot"></span>
          Unrivaled Clinical Mastery
        </div>
        
        <h1 class="hero-title kinetic-text">
          The Science of<br />
          <span class="text-gradient">Human Restoration.</span>
        </h1>
        
        <p class="hero-subtitle">
          Establishing the global standard for Joint Preservation and Robotic Arthroplasty in Hyderabad. We merge UK-trained HOD leadership with the absolute latest in USA-engineered surgical technology.
        </p>
        
        <div class="hero-actions">
          <a href="/symptoms" class="btn btn-primary lg">
            Symptom Checker <Zap size={18} />
          </a>
          <button class="btn btn-outline lg">
            <PlayCircle size={18} /> Watch Surgery Tech
          </button>
        </div>

        <div class="stats-strip">
          <div class="stat-glass-bubble parallax-bubble" data-parallax="0.1">
            <h4>15k+</h4>
            <span>Elite Procedures</span>
          </div>
          <div class="stat-glass-bubble parallax-bubble" data-parallax="0.15">
            <h4>0.01mm</h4>
            <span>Robotic Mapping</span>
          </div>
          <div class="stat-glass-bubble parallax-bubble" data-parallax="0.1">
            <h4>UK/US</h4>
            <span>Trained Faculty</span>
          </div>
        </div>
      </div>

      <BackgroundWaves client:load />
    </section>

    {/* ══ THE ELITE TECH STACK ══ */}
    <TechStackSection 
      eyebrow="Institutional Surgical Technology Platforms"
      title="The Internal Tech Stack"
      intro="We utilize the world's most advanced surgical and diagnostic platforms to ensure zero-compromise precision."
    >
      <RoboticArmSVG slot="robotic-visual" client:visible />

      <TechCard 
        index={0}
        category="Signature Technology"
        title="Stryker Mako 4.0® SmartRobotics"
        description="Sub-millimeter 3D mapping and haptic boundary protection for the most accurate joint replacements in India."
        image="/precision_mri_visual_1775752750316.webp"
        highlight={true}
        supports={["Robotic Arthroplasty Program", "Lower Extremity Reconstruction", "Hip Replacement Pathways"]}
      />

      <TechCard 
        index={1}
        category="Arthroscopic Visualization"
        title="Arthrex Panoscope Arthroscopy Platform"
        description="High-definition arthroscopic visualization system enabling precision ligament reconstruction, cartilage restoration, and minimally invasive joint stabilization."
        buttonText="Explore Upper Limb"
        buttonLink="/procedures/rotator-cuff-repair"
        image="/arthrex_panoscope_or_view_1775916323556.webp"
        supports={["Upper Extremity Reconstruction", "Sports Medicine Reconstruction", "Joint Preservation"]}
      />

      <TechCard 
        index={2}
        category="Performance Analytics"
        title="VALD Performance Centre"
        description="ForceDecks and DynaMo biomechanical analytics used for return-to-sport clearance, asymmetry detection, and objective rehabilitation tracking."
        buttonText="Sports Centre"
        buttonLink="/recovery"
        supports={["Return-to-Sport Clearance", "Performance Testing", "Injury Prevention Protocols"]}
      />

      <TechCard 
        index={3}
        category="Biologic Restoration"
        title="Precision Biologic Restoration Program"
        description="Joint preservation protocols using BMAC and PRP augmentation designed to restore native biomechanics before implant-based reconstruction."
        image="/biologic_restoration_lab_1775916303727.webp"
        supports={["Cartilage Preservation", "Early Osteoarthritis Management", "Joint Restoration Pathways"]}
      />
    </TechStackSection>

    {/* ══ ANATOMICAL DIVISIONS & GOVERNANCE ══ */}
    <DivisionSection
      eyebrow="Targeted Clinical Authority"
      title="Anatomical Divisions"
    >
      <DivisionCard
        title="Lower Extremity"
        description="Reconstruction & Joint Preservation"
        scope="Robotic Knee Replacement · Biological Preservation · Revision Arthroplasty"
        doctors={["Dr. Amith Reddy", "Dr. Ravi Teja"]}
        image="/anatomical_knee_schematic_1775754592483.webp"
        href="/clinical-divisions/lower-extremity"
        iconName="activity"
        highlight={true}
      />

      <DivisionCard
        title="Pelvic & Hip Reconstruction"
        description="DAA Arthroplasty & Complex Trauma"
        scope="Anterior Supine Hip · Pelvic Trauma · Revision Hip"
        doctors={["Dr. Nitish Bhan", "Dr. Prashanth Reddy"]}
        image="/anatomical_hip_schematic_1775754608460.webp"
        href="/clinical-divisions/pelvic-hip-reconstruction"
        iconName="layers"
      />

      <DivisionCard
        title="Upper Extremity"
        description="Arthrex 4K Hub & VALD Athletics"
        scope="Shoulder Arthroplasty · Rotator Cuff · Elbow Restoration"
        doctors={["Dr. Deepthi Nandan Reddy (HOD)", "Dr. Harsha Vardhana"]}
        image="/anatomical_shoulder_schematic_1775754624021.webp"
        href="/clinical-divisions/upper-extremity"
        iconName="zap"
      />

      <DivisionCard
        title="High-Performance Sports"
        description="VALD Intelligence & Return-to-Play"
        scope="ForceDecks Analysis · ACL Recovery · Athlete Optimization"
        doctors={["Dr. Harsha Vardhana", "Dr. Ravi Teja", "Dr. Deepthi Nandan Reddy (HOD)"]}
        image="/sports_performance_lab_1775752734674.webp"
        href="/clinical-divisions/sports-medicine"
        iconName="target"
      />
    </DivisionSection>
  </div>
</Layout>

<style>
  /* Local Home-specific styles can go here or remain in Home.css */
</style>

<script>
  // ══ MICRO PARALLAX LOGIC ══
  const bubbles = document.querySelectorAll('.parallax-bubble');
  
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    window.addEventListener('mousemove', (e) => {
      const { clientX, clientY } = e;
      const x = (clientX - window.innerWidth / 2) / 100;
      const y = (clientY - window.innerHeight / 2) / 100;
      
      bubbles.forEach(bubble => {
        const factor = bubble.getAttribute('data-parallax') || 0.1;
        // Cap transforms at 2px as per Executive Verdict
        const tx = Math.min(Math.max(x * factor, -2), 2);
        const ty = Math.min(Math.max(y * factor, -2), 2);
        bubble.style.transform = `translate(${tx}px, ${ty}px) scale(${1 + (Math.abs(tx)/200)})`;
      });
    });
  }
</script>
