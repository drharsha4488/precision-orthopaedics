---
import Layout from '../layouts/Layout.astro';
import { ShieldCheck, Award } from 'lucide-react';
import './About.css';

const schemaData = {
  "@context": "https://schema.org",
  "@type": "MedicalOrganization",
  "name": "Precision Orthopaedics",
  "description": "Hyderabad's Premier Robotic & Minimally Invasive Orthopaedic Team."
};
---

<Layout 
  title="Excellence in Motion | About Us" 
  description="Establishing the global standard for complex musculoskeletal reconstruction in India through relentless technological integration."
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <div class="about-page">
    <section class="about-hero">
      <div class="container text-center">
        <h1>Excellence in Motion</h1>
        <p class="hero-subtext">Establishing the global standard for complex musculoskeletal reconstruction in India through relentless technological integration and uncompromised surgical discipline.</p>
      </div>
    </section>

    <section class="container mt-xl mb-xl">
      <div class="about-grid">
         <div class="about-text">
           <h2 style="color: var(--primary); margin-bottom: 1.5rem">Our Genesis</h2>
           <p style="font-size: 1.15rem; color: var(--text-main); line-height: 1.8; margin-bottom: 1.5rem">
             Led by the President of the Shoulder and Elbow Society of India, Precision Orthopaedics was founded explicitly to eliminate the compromise between advanced technological care and deeply personalized patient mapping.
           </p>
           <p style="font-size: 1.15rem; color: var(--text-main); line-height: 1.8">
             Every surgeon on our board carries high-level international certifications—ranging from Swiss Olympic Fellowships to rigorous training protocols from the Mayo Clinic. We are not just surgeons; we are architects of joint preservation.
           </p>

           <ul class="accreditation-list mt-lg" style="list-style: none; padding: 0">
             <li style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1rem"><ShieldCheck size={24} style={{ color: 'var(--secondary)' }}/> <strong>JCI & NABH Accredited Protocols</strong></li>
             <li style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1rem"><Award size={24} style={{ color: 'var(--secondary)' }}/> <strong>Top Ranked Robotic Ortho Center (2025)</strong></li>
           </ul>
         </div>
         
         <div class="about-image-placeholder">
           <div style="background: #EBEBEB; width: 100%; height: 100%; min-height: 400px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-lg); color: #999; font-weight: bold">
              [Surgical Team / Facility Image Placeholder]
           </div>
         </div>
      </div>
    </section>
  </div>
</Layout>
