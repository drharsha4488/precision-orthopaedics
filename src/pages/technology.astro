---
import Layout from '../layouts/Layout.astro';
import { Cpu, Microscope, Activity, ShieldCheck, Zap, Crosshair, BarChart3, ChevronRight, CheckCircle } from 'lucide-react';
import './Technology.css';
---

<Layout 
  title="The Robotic Command Center | Advanced Technology" 
  description="We deploy the world's most advanced surgical arrays including Stryker Mako 4.0 and Arthrex Synergy UHD4 to achieve molecular precision."
>
  <div class="tech-hub-page">
    <section class="tech-hero animate-reveal">
       <div class="container text-center">
          <span class="elite-badge mb-sm">The Precision Tech Stack</span>
          <h1>The <span>Robotic Command</span> Center</h1>
          <p class="hero-subtitle">We deploy the world's most advanced surgical and diagnostic arrays to eliminate human error and achieve molecular precision.</p>
       </div>
    </section>

    <div class="container tech-grid-main">
      {/* TECHNOLOGY 1: STRYKER MAKO */}
      <div class="tech-block bento-card col-span-full border-glow animate-reveal">
         <div class="tech-header-split">
           <div class="tech-info">
              <span class="tech-category">Robotic Arthroplasty</span>
              <h2>Stryker Mako 4.0® SmartRobotics</h2>
              <p>Mako SmartRobotics combines three key components: 3D CT-based planning, AccuStop™ haptic technology, and insightful data analytics. By generating a 3D digital twin of your anatomy, we map the exact path before a single incision is made.</p>
              <div class="feature-list mt-md">
                 <div class="feature-item"><CheckCircle size={14}/> AccuStop™ Haptic Boundary Protection</div>
                 <div class="feature-item"><CheckCircle size={14}/> Virtual Range of Motion (vROM) Simulation</div>
                 <div class="feature-item"><CheckCircle size={14}/> Sub-millimeter Surgical Accuracy</div>
              </div>
           </div>
           <div class="tech-visual-large">
              <img src="/robotic_surgery_hero_1775752719796.png" alt="Mako Robotics" />
           </div>
         </div>
      </div>

      {/* TECHNOLOGY 2: ARTHREX SYNERGY UHD4 */}
      <div class="tech-block bento-card col-span-2 animate-reveal" style="animation-delay: 0.1s">
         <span class="tech-category">Surgical Imaging</span>
         <h3>Arthrex Synergy UHD4™</h3>
         <p>The first 4K all-in-one surgical imaging system. It provides native 4K resolution and 10-bit color depth, delivering 58x more color information than standard HD systems.</p>
         <div class="tech-stats-grid mt-md">
            <div class="t-stat"><span>Resolution</span><strong>Native 4K</strong></div>
            <div class="t-stat"><span>Color Depth</span><strong>10-Bit HDR</strong></div>
         </div>
         <div class="mt-md">
            <p class="body-text-sm">Used exclusively by Dr. Deepthi and Dr. Ravi Teja for complex shoulder and knee ligament reconstructions.</p>
         </div>
      </div>

      {/* TECHNOLOGY 3: VALD PERFORMANCE */}
      <div class="tech-block bento-card col-span-1 animate-reveal" style="animation-delay: 0.2s">
         <span class="tech-category">Sports Performance</span>
         <h3>VALD ForceDecks</h3>
         <p>Dual force plate technology that analyzes how athletes move, land, and produce force.</p>
         <ul class="mini-feature-list mt-sm">
            <li>Biomechanical Symmetry Index</li>
            <li>Rate of Force Development (RFD)</li>
            <li>Neuromuscular Readiness</li>
         </ul>
         <div class="mt-md text-secondary" style="font-weight: 600; font-size: 0.9rem">
            Data-driven RTS clearing by Dr. Harsha.
         </div>
      </div>

      {/* TECHNOLOGY 4: VALD DYNAMO */}
      <div class="tech-block bento-card col-span-1 animate-reveal" style="animation-delay: 0.3s">
         <span class="tech-category">Strength Analysis</span>
         <h3>VALD DynaMo™</h3>
         <p>Handheld dynamometry and inclinometry for precise muscle strength and ROM tracking.</p>
         <div class="tech-visual-mini mt-sm">
            <Activity size={40} class="text-secondary" />
         </div>
      </div>
    </div>

    <section class="tech-trust-banner container mt-xl mb-xl text-center">
       <div class="bento-card bento-dark p-xl">
          <ShieldCheck size={48} class="text-secondary mb-md" style={{ margin: '0 auto' }} />
          <h2>Zero Compromise Sterility</h2>
          <p class="body-text">Our tech stack operates within Class 100 Laminar Airflow suites at Apollo Hospitals, ensuring the absolute lowest risk of surgical site infection in the region.</p>
       </div>
    </section>
  </div>
</Layout>
