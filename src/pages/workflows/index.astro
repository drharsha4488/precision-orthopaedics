---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.jsx';
import Footer from '../../components/Footer.jsx';
import { workflowData } from '../../services/workflowData';
import { Settings, ArrowRight, Gauge, CheckCircle } from 'lucide-react';

const workflows = Object.entries(workflowData).map(([slug, data]) => ({
  slug,
  ...data
}));
---

<Layout title="Surgical & Diagnostic Workflows | Precision Ortho Process Hub">
  <Header client:load />

  <section className="bg-primary text-white py-20 border-b-4 border-secondary">
    <div className="container">
      <h1 className="display-xl">Surgical <span className="text-secondary">Workflows</span></h1>
      <p className="hero-subtext max-w-3xl mt-6">
        Transparency in the process. Our surgical and diagnostic workflows represent the meticulous sequencing 
        of technology and clinical expertise to ensure predictable, elite-grade outcomes.
      </p>
    </div>
  </section>

  <section className="py-20 bg-gray-50">
    <div className="container">
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {workflows.map((flow) => (
          <div className="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow flex flex-col">
            <div className="p-8 flex-grow">
              <div className="flex items-center gap-3 text-secondary mb-4">
                <Settings size={24} />
                <span className="text-sm font-bold tracking-widest uppercase">Clinical Workflow</span>
              </div>
              <h3 className="text-2xl font-bold text-primary mb-2">{flow.h1}</h3>
              <p className="text-sm text-secondary font-bold mb-4">Goal: {flow.clinicalObjective.split('.')[0]}.</p>
              
              <div className="space-y-4 mb-6">
                {flow.protocolSteps.slice(0, 3).map(step => (
                  <div className="flex items-start gap-3">
                    <div className="w-6 h-6 rounded-full bg-secondary/10 text-secondary flex items-center justify-center flex-shrink-0 mt-0.5">
                      <span className="text-[10px] font-black">?</span>
                    </div>
                    <div>
                      <div className="text-xs font-bold text-primary uppercase">{step.step}</div>
                      <div className="text-sm text-gray-600 line-clamp-1">{step.action}</div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
            
            <div className="px-8 py-6 bg-gray-50 border-t border-gray-200">
              <a href={`/workflows/${flow.slug}`} className="flex items-center justify-between font-bold text-primary hover:text-secondary transition-colors">
                Examine Workflow <ArrowRight size={20} />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .hero-subtext {
    font-size: 1.25rem;
    color: #E0E1DD;
    line-height: 1.6;
  }
  .line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
