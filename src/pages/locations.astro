---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.jsx';
import { MapPin, Phone, Mail, Clock, ShieldCheck, Map, ArrowRight } from 'lucide-react';
import './Locations.css';

const locations = [
  {
    name: "Apollo Hospitals | Financial District",
    badge: "Primary Clinical Hub",
    address: "Financial District, Gachibowli, Nanakramguda, Hyderabad, Telangana 500032",
    coordination: "+91 78429 32051",
    hospitalDesk: "+91 40 2360 7777",
    email: "consult@precisionortho.in",
    hours: "Mon - Sat: 09:00 AM - 05:00 PM",
    mapUrl: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d475.8618042255977!2d78.35489664531642!3d17.416853094342486!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bcb95006e7405cd%3A0xdd985c73b9df1b92!2sApollo%20Hospital%2C%20Nankramguda!5e0!3m2!1sen!2sin!4v1775980847152!5m2!1sen!2sin",
    features: [
      "Stryker Mako 4.0 Robotic System",
      "Arthrex Synergy UHD4 4K Hub",
      "VALD Performance Diagnostic Lab",
      "Level 1 Trauma Emergency Care",
      "JCI & NABH Accredited Facility",
      "24/7 Orthopaedic Emergency Deck"
    ]
  }
];
---

<Layout title="Clinical Locations | Precision Orthopaedics Hyderabad">
  <div class="locations-page">
    <Header client:load />

    <section class="locations-hero animate-reveal">
      <div class="container text-center">
        <h1 class="display-xl text-gradient-cyan">Strategic <span class="text-secondary text-white">Clinical Hubs</span></h1>
        <p class="hero-subtext">
          Operating out of India's premier multi-speciality ecosystems to ensure absolute surgical safety and 
          unmatched infrastructure for complex musculoskeletal restoration.
        </p>
      </div>
    </section>

    <section class="locations-content">
      <div class="container">
        {locations.map((loc) => (
          <div class="location-card-lg">
            <div class="loc-info-glass glass-premium animate-reveal">
              <span class="loc-badge">
                <ShieldCheck size={14} /> {loc.badge}
              </span>
              <h2>{loc.name}</h2>
              <p class="loc-description">
                Institutional Partner for Advanced Robotic & Sports Medicine.
              </p>
              
              <ul class="loc-contact-list">
                <li>
                  <MapPin class="loc-icon" size={20} />
                  <div>
                    <span class="loc-label">Address</span>
                    <span class="loc-value">{loc.address}</span>
                  </div>
                </li>
                <li>
                  <Phone class="loc-icon" size={20} />
                  <div>
                    <span class="loc-label">Precision Coordination</span>
                    <a href={`tel:${loc.coordination.replace(/\s/g, '')}`} class="loc-value">{loc.coordination}</a>
                  </div>
                </li>
                <li>
                  <Phone class="loc-icon" size={20} />
                  <div>
                    <span class="loc-label">Hospital Desk</span>
                    <a href={`tel:${loc.hospitalDesk.replace(/\s/g, '')}`} class="loc-value">{loc.hospitalDesk}</a>
                  </div>
                </li>
                <li>
                  <Clock class="loc-icon" size={20} />
                  <div>
                    <span class="loc-label">Clinical Hours</span>
                    <span class="loc-value">{loc.hours}</span>
                  </div>
                </li>
              </ul>

              <div class="loc-infrastructure">
                <h3>Institutional Grade Infrastructure</h3>
                <div class="infra-grid">
                  {loc.features.map(f => (
                    <div class="infra-item">
                      <ShieldCheck size={14} class="text-secondary" />
                      <span>{f}</span>
                    </div>
                  ))}
                </div>
              </div>

              <div class="loc-actions">
                <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(loc.address)}`} target="_blank" class="btn btn-primary w-100">
                  <Map size={18} /> Get Directions
                </a>
                <a href="#appointment" class="btn btn-outline w-100">
                  Consultation <ArrowRight size={18} />
                </a>
              </div>
            </div>

            <div class="loc-map-wrapper border-glow-cyan">
              <iframe 
                src={loc.mapUrl}
                class="map-iframe"
                loading="lazy">
              </iframe>
            </div>
          </div>
        ))}
      </div>
    </section>

    <Footer />
  </div>
</Layout>
