---
import Layout from '../../layouts/Layout.astro';
import { Award, Briefcase, GraduationCap, MapPin, CheckCircle, Calendar, ChevronLeft, Globe } from 'lucide-react';
import { doctorDetails } from '../../services/doctorDetails';
import '../DoctorProfile.css';

export async function getStaticPaths() {
  return Object.keys(doctorDetails).map((slug) => ({
    params: { slug },
    props: { doctor: doctorDetails[slug] },
  }));
}

const { doctor } = Astro.props;
const { slug } = Astro.params;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Physician",
  "name": doctor.name,
  "medicalSpecialty": doctor.focus,
  "affiliation": {
    "@type": "MedicalClinic",
    "name": "Precision Orthopaedics"
  },
  "telephone": "+91 40 2360 7777"
};
---

<Layout 
  title={`${doctor.name} | ${doctor.title}`} 
  description={doctor.bio.substring(0, 160)}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <div class="profile-page">
    <div class="container profile-layout">
      <div class="profile-sidebar">
        <a href="/doctors" class="back-link mb-sm" style="display: inline-flex; align-items: center; gap: 5px; color: var(--text-muted)">
          <ChevronLeft size={16} /> Back to Directory
        </a>
        <div class="profile-avatar-card">
          <div class="avatar-large">
             <img src={`https://ui-avatars.com/api/?name=${encodeURIComponent(doctor.name)}&background=0A1525&color=00E5FF&size=200`} alt={doctor.name} />
          </div>
          <h2>{doctor.name}</h2>
          <p class="profile-subtitle">{doctor.title}</p>
          <p class="profile-focus">{doctor.focus}</p>
          
          <div class="profile-ctas">
            <button class="btn btn-primary w-100 mb-sm">
              <Calendar size={16} /> Book Appointment
            </button>
            <button class="btn btn-outline w-100">
              Request Second Opinion
            </button>
          </div>
        </div>

        <div class="profile-info-box">
          <h4>Global Training Hub</h4>
          <div class="location-item">
            <Globe size={16} />
            <div>
              <strong>Clinical Pedigree</strong>
              <p>Advanced surgical protocols integrated from leading UK and US institutes.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="profile-main">
        <section class="bio-section">
          <h3>Specialist Overview</h3>
          <p class="bio-text">{doctor.bio}</p>
        </section>

        <div class="credentials-grid">
          <div class="cred-card">
            <Briefcase class="cred-icon" />
            <h4>Seniority</h4>
            <p>{doctor.experience}</p>
          </div>
          <div class="cred-card">
            <Award class="cred-icon" />
            <h4>Authority</h4>
            <p>{doctor.fellowships}</p>
          </div>
          <div class="cred-card">
            <GraduationCap class="cred-icon" />
            <h4>Credentials</h4>
            <p>{doctor.qualifications}</p>
          </div>
        </div>

        <section class="specialties-section">
          <h3>Focus Areas</h3>
          <ul class="specialty-checklist">
            {doctor.specialties.map((spec) => (
              <li><CheckCircle size={18} class="check-icon" /> {spec}</li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </div>
</Layout>
