---
import Layout from '../../layouts/Layout.astro';
import { Award, Briefcase, GraduationCap, MapPin, CheckCircle, Calendar, ChevronLeft, Globe, Activity, MessageSquare } from 'lucide-react';
import { doctorDetails } from '../../services/doctorDetails';
import '../DoctorProfile.css';

export async function getStaticPaths() {
  return Object.keys(doctorDetails).map((slug) => ({
    params: { slug },
    props: { doctor: doctorDetails[slug] },
  }));
}

const { doctor } = Astro.props;
const { slug } = Astro.params;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Physician",
  "name": doctor.name,
  "medicalSpecialty": "Orthopaedic Surgery",
  "description": doctor.bio,
  "knowsAbout": doctor.specialties,
  "image": `https://precisionortho.com${doctor.image}`,
  "affiliation": {
    "@type": "Hospital",
    "name": "Apollo Hospitals Financial District",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Nanakramguda",
      "addressLocality": "Hyderabad",
      "addressRegion": "Telangana",
      "postalCode": "500032",
      "addressCountry": "IN"
    }
  },
  "telephone": "+91 78429 32051"
};
---

<Layout 
  title={`${doctor.name} | ${doctor.title}`} 
  description={doctor.bio.substring(0, 160)}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <div class="profile-page">
    <div class="container profile-layout">
      <div class="profile-sidebar">
        <a href="/doctors" class="back-link mb-sm" style="display: inline-flex; align-items: center; gap: 5px; color: var(--text-muted)">
          <ChevronLeft size={16} /> Back to Directory
        </a>
        <div class="profile-avatar-card">
          <div class="unit-tag">{doctor.unitName}</div>
          <div class="avatar-large">
             <img src={doctor.image} alt={doctor.name} />
          </div>
          <h2>{doctor.name}</h2>
          <p class="profile-subtitle">{doctor.role}</p>
          <p class="platform-tag">{doctor.platform}</p>
          <p class="profile-focus">{doctor.focus}</p>
          
          <div class="profile-ctas">
            <a href={doctor.appointmentLink} class="btn btn-primary w-100 mb-sm" style="text-decoration: none; justify-content: center;" target="_blank">
              <Calendar size={16} /> Book Appointment
            </a>
            <a href="https://wa.me/917842932051" class="btn btn-outline w-100 mb-sm" style="text-decoration: none; justify-content: center;" target="_blank">
              <MessageSquare size={16} /> Talk to Coordinator
            </a>
            <button class="btn btn-text w-100">
              Request Second Opinion
            </button>
          </div>
        </div>

        <div class="profile-info-box">
          <h4>Global Training Hub</h4>
          <div class="location-item">
            <Globe size={16} />
            <div>
              <strong>Clinical Pedigree</strong>
              <p>Advanced surgical protocols integrated from leading UK and US institutes.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="profile-main">
        <section class="bio-section">
          <h3>Specialist Overview</h3>
          <p class="bio-text">{doctor.bio}</p>
        </section>

        <div class="credentials-grid">
          <div class="cred-card">
            <Briefcase class="cred-icon" />
            <h4>Seniority</h4>
            <p>{doctor.experience} Expertise</p>
          </div>
          <div class="cred-card">
            <Activity size={24} class="cred-icon" />
            <h4>Volume</h4>
            <p>{doctor.specificVolume}</p>
          </div>
          <div class="cred-card">
            <Award class="cred-icon" />
            <h4>Authority</h4>
            <p>{doctor.fellowships}</p>
          </div>
          <div class="cred-card">
            <GraduationCap class="cred-icon" />
            <h4>Credentials</h4>
            <p>{doctor.qualifications}</p>
          </div>
        </div>

        <section class="specialties-section">
          <h3>Focus Areas</h3>
          <ul class="specialty-checklist">
            {doctor.specialties.map((spec) => (
              <li><CheckCircle size={18} class="check-icon" /> {spec}</li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </div>

  <div class="sticky-cta-bar">
    <a href={doctor.appointmentLink} class="btn btn-primary" target="_blank">
      <Calendar size={18} /> Book Appointment
    </a>
    <a href="https://wa.me/917842932051" class="btn btn-outline" target="_blank">
      <MessageSquare size={18} /> Talk to Coordinator
    </a>
  </div>
</Layout>
