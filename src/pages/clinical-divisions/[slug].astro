---
import Layout from '../../layouts/Layout.astro';
import { 
  ShieldCheck, 
  Activity, 
  Target, 
  Cpu, 
  Microscope, 
  CheckCircle, 
  ChevronRight, 
  Phone, 
  ArrowRight, 
  Gauge, 
  Video, 
  BarChart3,
  Globe,
  Settings,
  Crosshair,
  Zap,
  HelpCircle,
  Shapes
} from 'lucide-react';
import { divisions, commonStats, planningWorkflow } from '../../services/divisionData';
import SchemaOrg from '../../components/SchemaOrg.astro';
import '../SiloPage.css';
import './DivisionHub.css';

export async function getStaticPaths() {
  return Object.keys(divisions).map((slug) => ({
    params: { slug },
    props: { data: divisions[slug] },
  }));
}

const { data } = Astro.props;
const { slug } = Astro.params;
---

<Layout title={data.title} description={data.metaDescription}>
  <SchemaOrg type="division" data={data} slug={slug} />

  <div class="division-hub-page">
    {/* ══ 1. INSTITUTIONAL HERO ══ */}
    <section class="division-hero animate-reveal">
      <div class="container hero-grid">
        <div class="hero-content">
          <div class="institutional-badge">Precision Clinical Division</div>
          <h1>{data.h1}</h1>
          <p class="mission-statement">{data.clinicalPhilosophy}</p>
          
          <div class="hero-actions mt-xl">
             <a href="tel:+917842932051" class="btn btn-primary lg">
               <Phone size={18} /> Book Board Evaluation
             </a>
             <p class="cta-subtext">Direct Institutional Hotline: +91 78429 32051</p>
          </div>
        </div>
        
        <div class="hero-visual-authority">
           <div class="governance-card border-glow">
              <ShieldCheck size={32} class="text-secondary mb-sm" />
              <h4>Institutional Governance</h4>
              <ul class="gov-list">
                <li>Board-Reviewed Protocols</li>
                <li>NAQI infection Audits</li>
                <li>USA-Standard Planning</li>
                <li>Accelerated Rehab Pipeline</li>
              </ul>
           </div>
        </div>
      </div>
    </section>

    {/* ══ 2. OUTCOME BENCHMARKS STRIP (Full Width) ══ */}
    <section class="outcome-benchmarks-strip">
       <div class="container">
          <div class="benchmarks-grid">
             {data.outcomeBenchmarks.map(benchmark => (
               <div class="benchmark-item">
                  <CheckCircle size={18} class="text-secondary" />
                  <span>{benchmark}</span>
               </div>
             ))}
          </div>
       </div>
    </section>

    {/* ══ 2.5 ELIGIBILITY & COMPLEXITY SPECTRUM ══ */}
    <section class="eligibility-complexity container section-block">
       <div class="bento-grid-institutional">
          <div class="bento-card bg-dark-alt">
             <div class="card-header">
                <UserCheck size={28} class="text-secondary" />
                <h2>Program Eligibility Signals</h2>
             </div>
             <p class="mb-lg text-muted">Who this clinical division serves:</p>
             <ul class="eligibility-list-v3">
                {data.eligibilitySignals.map(signal => (
                  <li><ArrowRight size={14} class="text-secondary" /> {signal}</li>
                ))}
             </ul>
          </div>

          <div class="bento-card bg-dark-alt">
             <div class="card-header">
                <ActivitySquare size={28} class="text-secondary" />
                <h2>Case Complexity Spectrum</h2>
             </div>
             <div class="complexity-stack mt-lg">
                {data.caseComplexity.map(item => (
                  <div class="complexity-item">
                     <span class="c-level">{item.level}</span>
                     <span class="c-case">{item.case}</span>
                  </div>
                ))}
             </div>
             <p class="mt-xl text-muted text-sm">Every complexity tier is overseen by the Precision Surgical Board.</p>
          </div>
       </div>
    </section>

    {/* ══ 3. TREATMENT PATHWAY LOGIC ══ */}
    <section class="container section-block">
       <div class="pathway-ladder-container bento-card p-xl dark-glass">
          <div class="pathway-header">
             <Shapes size={24} class="text-secondary" />
             <h2>Treatment Pathway Logic</h2>
          </div>
          <div class="pathway-ladder">
             {data.pathwayLogic.steps.map((step, idx) => (
               <div class="pathway-step" style={`--step-color: ${step.color}`}>
                  <div class="step-num">{idx + 1}</div>
                  <div class="step-label">{step.label}</div>
                  {idx < data.pathwayLogic.steps.length - 1 && <ArrowRight size={20} class="step-arrow" />}
               </div>
             ))}
          </div>
          <p class="pathway-subtext mt-lg">{data.selectionLogic}</p>
       </div>
    </section>

    {/* ══ 3.5 SPORTS CLEARANCE PROTOCOL (Conditional) ══ */}
    {slug === 'sports-medicine' && data.clearanceProtocol && (
      <section class="sports-clearance container section-block">
         <div class="bento-card p-xl border-glow">
            <div class="section-header text-center mb-xl">
               <Gauge size={32} class="text-secondary mb-sm" />
               <h2>Return-to-Sport Clearance Protocol</h2>
               <p>Objective VALD kinetic benchmarks required for professional clearance.</p>
            </div>
            <div class="clearance-grid">
               {data.clearanceProtocol.map(item => (
                 <div class="clearance-item">
                    <span class="cl-tool">{item.tool}</span>
                    <span class="cl-metric">{item.metric}</span>
                    <span class="cl-target">{item.target}</span>
                 </div>
               ))}
            </div>
         </div>
      </section>
    )}

    {/* ══ 4. PROGRAM ARCHITECTURE (THE 3 TIERS) ══ */}
    <div class="program-architecture">
      {data.programs.map((program) => (
        <section class="program-section container section-block">
           <div class="program-doctrine-card">
              <div class="program-header">
                 <span class="program-tag">Program Doctrine</span>
                 <h2>{program.name}</h2>
              </div>
              <p class="program-philosophy">{program.doctrine}</p>
              
              <div class="program-main-grid mt-xl">
                 {/* Technology Mapping Layer */}
                 <div class="tech-hub">
                    <h3>Technological Arsenal</h3>
                    <div class="tech-stack-mini">
                       {program.techMapping.map(tech => (
                         <div class="tech-item-mapped shadow-sm">
                            <tech.icon size={22} class="text-secondary" />
                            <div>
                               <strong>{tech.name}</strong>
                               <p>{tech.desc}</p>
                            </div>
                         </div>
                       ))}
                    </div>
                 </div>

                 {/* Clinical Spokes (Procedures) */}
                 <div class="procedure-hub">
                    <h3>Clinical Pathways</h3>
                    <div class="procedure-list-vertical">
                       {program.procedures.map(proc => (
                         <a href={`/specialities/${proc.slug}`} class="procedure-link-row">
                            <span>{proc.name}</span>
                            <ChevronRight size={18} class="text-secondary" />
                         </a>
                       ))}
                    </div>
                 </div>
              </div>
              <div class="outcome-evidence-strip mt-xl">
                 <Shield size={16} class="text-secondary" />
                 <span><strong>{data.h1} Outcome Evidence:</strong> {data.outcomeEvidence.strategy}</span>
              </div>
           </div>
        </section>
      ))}
    </div>

    {/* ══ 5. SURGICAL BOARD & GOVERNANCE ══ */}
    <section class="surgical-board-governance container section-block">
       <div class="bento-grid-institutional">
          <div class="bento-card col-span-2 board-card">
             <div class="card-header">
                <Globe size={28} class="text-secondary" />
                <h2>Division Surgical Board</h2>
             </div>
             <p class="mb-lg">Every complex restoration is reviewed by the full board to ensure regional best-practice alignment.</p>
             <div class="board-members-strip">
                {data.boardMembers.map(member => (
                  <div class="board-member-tag">
                     <div class="dot active"></div>
                     <span>{member}</span>
                  </div>
                ))}
             </div>
          </div>
          
          <div class="bento-card planning-card">
             <h3>Planning Workflow</h3>
             <div class="planning-stack mt-md">
                {planningWorkflow.map((step, idx) => (
                  <div class="planning-step-item">
                     <span class="p-idx">0{idx + 1}</span>
                     <span>{step}</span>
                  </div>
                ))}
             </div>
          </div>
       </div>
    </section>

    {/* ══ 6. SELECTION LOGIC FOOTER STRIP ══ */}
    <section class="selection-footer bg-dark-alt py-xl mt-xl">
       <div class="container text-center">
          <h2 class="mb-md">Choosing the Right Program</h2>
          <p class="body-text max-width-800 margin-auto">{data.selectionLogic}</p>
          <div class="lateral-grid mt-xl">
             {Object.keys(divisions).filter(k => k !== slug).map(key => (
               <a href={`/clinical-divisions/${key}`} class="lateral-card border-glow">
                  <h3>{divisions[key].h1}</h3>
                  <ArrowRight size={18} class="text-secondary" />
               </a>
             ))}
          </div>
       </div>
    </section>

    {/* ══ 7. FAQ SCHEMA BLOCK ══ */}
    <section class="division-faq container section-block mb-xl">
       <div class="bento-card p-xl dark-glass">
          <h2 class="mb-xl text-center">Inquiry & Consultation Clearing</h2>
          <div class="faq-accordion">
             {data.faqs.map(faq => (
               <div class="faq-node">
                  <div class="faq-q">
                     <HelpCircle size={18} class="text-secondary" />
                     <h4>{faq.q}</h4>
                  </div>
                  <p class="faq-a">{faq.a}</p>
               </div>
             ))}
          </div>
       </div>
    </section>
  </div>
</Layout>
  </div>
</Layout>
