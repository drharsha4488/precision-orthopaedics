---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { FileText, User, Calendar, Tag } from 'lucide-react';
import '../../index.css';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<Layout 
  title={article.data.title} 
  description={article.data.description}
  heroImage={article.data.heroImage}
>
  <div class="article-detail-page pt-[180px] pb-24">
    <div class="container max-w-[900px] mx-auto">
      <div class="article-header mb-12 text-center">
        <div class="tags-container flex justify-center gap-2 mb-6 flex-wrap">
          {article.data.tags.map(tag => (
            <span class="bg-secondary/10 text-secondary border border-secondary/20 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider flex items-center gap-1">
              <Tag size={12} /> {tag}
            </span>
          ))}
        </div>
        
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6 leading-tight">{article.data.title}</h1>
        <p class="text-xl text-light/70 mb-8 max-w-[800px] mx-auto">{article.data.description}</p>
        
        <div class="author-meta flex items-center justify-center gap-6 text-sm text-light/60 border-t border-b border-light/10 py-4">
          <div class="flex items-center gap-2">
            <User size={16} class="text-secondary" />
            <span class="font-medium text-white">{article.data.author}</span>
          </div>
          <div class="flex items-center gap-2">
            <Calendar size={16} class="text-secondary" />
            <span>{article.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </div>
        </div>
      </div>

      {article.data.heroImage && (
        <div class="article-hero-image mb-12 rounded-2xl overflow-hidden border border-light/10 relative">
          <div class="absolute inset-0 bg-gradient-to-t from-dark to-transparent opacity-60 z-10"></div>
          <img fetchpriority="high" decoding="async"
            src={article.data.heroImage}
            alt={article.data.title} 
            class="w-full h-[400px] object-cover"
          />
        </div>
      )}

      <article class="prose prose-invert prose-lg max-w-none prose-headings:text-white prose-a:text-secondary hover:prose-a:text-white prose-strong:text-white prose-img:rounded-xl">
        <Content />
      </article>

      <div class="mt-16 pt-8 border-t border-light/10 text-center">
        <div class="bg-dark-alt p-8 rounded-2xl border border-light/10 shadow-2xl">
          <h3 class="text-2xl font-bold text-white mb-4">Need an Expert Opinion?</h3>
          <p class="text-light/70 mb-6">Consult with the Precision Surgical Board regarding your condition.</p>
          <a href="tel:+917842932051" class="btn btn-primary inline-flex items-center gap-2">
            Request Evaluation <FileText size={16} />
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
