---
import Layout from '../../layouts/Layout.astro';
import { ShieldCheck, Activity, Trophy, Crosshair, Users, Microscope } from 'lucide-react';
import { doctors } from '../../services/data';
import RosterFilter from '../../components/RosterFilter';
import '../Doctors.css';
---

<Layout 
  title="Our Orthopaedic Specialists | The Precision Roster" 
  description="Fellowship-trained surgeons delivering sub-specialty care across robotic arthroplasty, sports medicine, and joint preservation. Meet the Medical Board of Excellence."
>
  <div class="doctors-page">
    {/* ══ HEADER ══ */}
    <section class="doctors-hero animate-reveal">
      <div class="container text-center">
        <div class="hero-badge">Medical Board of Excellence</div>
        <h1>Meet Our <span>Orthopaedic</span> Specialists</h1>
        <p class="header-subtext">
          Fellowship-trained surgeons delivering sub-specialty care across robotic arthroplasty, sports medicine, and joint preservation. Every complex case is reviewed by our Collaborative Surgical Board.
        </p>
      </div>
    </section>

    {/* ══ AUTHORITY BANNER ══ */}
    <section class="authority-prime-banner container">
      <div class="prime-grid">
        <div class="prime-item">
          <Activity size={24} class="text-secondary" />
          <div class="prime-text">
            <h4>15,000+</h4>
            <span>Procedures Across Programs</span>
          </div>
        </div>
        <div class="prime-item">
          <Crosshair size={24} class="text-secondary" />
          <div class="prime-text">
            <h4>0.01mm</h4>
            <span>Robotic Mapping Accuracy</span>
          </div>
        </div>
        <div class="prime-item">
          <Users size={24} class="text-secondary" />
          <div class="prime-text">
            <h4>Global</h4>
            <span>Fellowship Faculty</span>
          </div>
        </div>
        <div class="prime-item">
          <ShieldCheck size={24} class="text-secondary" />
          <div class="prime-text">
            <h4>Lowest</h4>
            <span>Revision Rate Stats</span>
          </div>
        </div>
      </div>
    </section>

    {/* ══ ROSTER HUB (React) ══ */}
    <section class="container mb-xl">
       <RosterFilter client:load doctors={doctors} />
    </section>

    {/* ══ COLLABORATIVE BOARD UPGRADE ══ */}
    <section class="board-excellence-section container mb-xl">
      <div class="bento-card border-glow p-xl">
         <div class="board-header">
            <Microscope size={40} class="text-secondary" />
            <div>
              <h2>Every Complex Case Is Board-Reviewed Before Surgery</h2>
              <p>Collective Clinical Intelligence for High-Performance Restoration</p>
            </div>
         </div>
         
         <div class="board-bullets mt-lg">
            <div class="bullet-item">
              <ShieldCheck size={20} class="text-secondary" />
              <div>
                <strong>Eliminating Revision Risk</strong>
                <p>Pre-operative review of all complex primary and revision cases to optimize outcomes.</p>
              </div>
            </div>
            <div class="bullet-item">
              <Activity size={20} class="text-secondary" />
              <div>
                <strong>Optimized Implant Selection</strong>
                <p>Ensuring the exact technology (Mako, Arthrex, VALD) is matched to patient anatomy.</p>
              </div>
            </div>
            <div class="bullet-item">
              <Trophy size={20} class="text-secondary" />
              <div>
                <strong>Precision Rehabilitation Strategy</strong>
                <p>Unified board-led protocol for post-surgical physical restoration.</p>
              </div>
            </div>
         </div>
      </div>
    </section>
  </div>
</Layout>
