---
import Layout from '../../layouts/Layout.astro';
import { Shield, ChevronRight, ArrowRight, CheckCircle, Target, Microscope, Video, Layers, Cpu, Crosshair, ShieldCheck, Activity } from 'lucide-react';
import { programData } from '../../services/programData';
import { divisions } from '../../services/divisionData';
import './ProgramTemplate.css';

export async function getStaticPaths() {
  return Object.keys(programData).map((slug) => ({
    params: { slug },
    props: { data: programData[slug] },
  }));
}

const { data } = Astro.props;
const { slug } = Astro.params;

// ══ SAFETY GUARD: REDIRECT IF DATA IS MISSING ══
if (!data) {
  return Astro.redirect('/404');
}

const parentDiv = divisions[data.canonicalParent?.division] || divisions['lower-extremity'];
---

<Layout title={data.title} description={data.doctrine}>
  <div class="clinical-program-page">
    {/* ══ CINEMATIC HERO ══ */}
    <section class="program-hero animate-reveal">
      <img src={data.heroImage} alt={data.h1} class="hero-bg-visual" />
      <div class="hero-overlay"></div>
      <div class="editorial-watermark">PRECISION</div>
      
      <div class="container">
        {/* ══ HIERARCHY STRIP (INTEGRATED) ══ */}
        <div class="institutional-hierarchy-strip mb-xl">
           <div class="h-parent">
              <span class="h-label">Division</span>
              <a href={`/clinical-divisions/${data.canonicalParent?.division}`}>{parentDiv.h1?.split(' | ')[0] || 'Division'}</a>
              <span class="h-separator">/</span>
              <span class="h-label">Institutional Program</span>
              <span class="h-active">{data.h1}</span>
           </div>
        </div>

        <div class="program-hero-grid">
          <div class="hero-text">
            <div class="institutional-marker mb-md"><Shield size={14}/> Institutional Program Hub</div>
            <h1 class="mb-lg">{data.h1}</h1>
            <p class="body-text text-xl mb-xl">{data.doctrine}</p>
            
            {data.institutionalStats && (
              <div class="hero-stats-row">
                <div class="p-stat-pill">
                  <span class="p-stat-lab">Program Volume</span>
                  <span class="p-stat-val">{data.institutionalStats.volume}</span>
                </div>
                <div class="p-stat-pill">
                  <span class="p-stat-lab">Surgical Precision</span>
                  <span class="p-stat-val">{data.institutionalStats.precision}</span>
                </div>
                <div class="p-stat-pill">
                  <span class="p-stat-lab">Core Integration</span>
                  <span class="p-stat-val">{data.institutionalStats.integration}</span>
                </div>
              </div>
            )}
            
            <a href="tel:+917842932051" class="btn btn-primary lg mt-xl">
               Consult Program Coordinator <ArrowRight size={16}/>
            </a>
          </div>
          
          <div class="hero-meta bento-card dark-glass">
             <h3 class="mb-lg">Program Leadership</h3>
             <div class="leadership-grid">
                <div class="l-unit">
                   <span class="l-label">Primary Faculty</span>
                   {data.leadership?.primary?.map(lead => (
                     <div class="l-person">
                        <strong>{lead.name}</strong>
                        <span>{lead.role}</span>
                     </div>
                   ))}
                </div>
                {data.leadership?.boardSupport && (
                  <div class="l-unit">
                     <span class="l-label">Board Governance</span>
                     {data.leadership.boardSupport?.map(lead => (
                       <div class="l-person">
                          <strong>{lead.name}</strong>
                          <span>{lead.role}</span>
                       </div>
                     ))}
                  </div>
                )}
             </div>
          </div>
        </div>
      </div>
    </section>

    {/* ══ CONTEXT STRIP ══ */}
    <section class="outcome-evidence-bar border-y border-light/10">
       <div class="container bar-flex">
          <div class="bar-item">
             <Target size={18} class="text-secondary" />
             <span><strong>Program Strategy:</strong> {data.clinicalObjective}</span>
          </div>
       </div>
    </section>

    {/* ══ SELECTION PROTOCOL ══ */}
    <section class="section-block container">
       <div class="bento-grid-institutional">
          <div class="bento-card col-span-2 dark-glass">
             <h2 class="section-title">Institutional Selection Protocol</h2>
             <div class="decision-grid">
                {data.decisionCriteria?.map(item => (
                   <div class="decision-item">
                      <div class="check-icon-box">
                        <CheckCircle size={18} class="text-secondary" />
                      </div>
                      <span>{item}</span>
                   </div>
                ))}
             </div>
          </div>
          <div class="bento-card col-span-1 dark-glass">
             <h3 class="mb-lg">Technical Infrastructure</h3>
             <div class="tech-stack-vertical">
                {data.technology?.map(tech => (
                   <div class="tech-item-mini mb-lg">
                      <div class="tech-icon-circle">
                        {tech.icon && <tech.icon size={20} class="text-secondary" />}
                      </div>
                      <div>
                         <strong>{tech.name}</strong>
                         <p class="text-muted">{tech.desc}</p>
                      </div>
                   </div>
                ))}
             </div>
          </div>
       </div>
    </section>

    {/* ══ TECHNICAL LIBRARY ══ */}
    <section class="section-block bg-dark-alt">
       <div class="container">
          <div class="display-header text-center mb-xxl">
             <span class="editorial-tag">Technical Execution</span>
             <h2 class="section-title">Program Procedure Spokes</h2>
             <p class="max-width-600 mx-auto text-muted">Technical documentation for surgical procedures governed by this program protocol.</p>
          </div>
          
          <div class="spoke-grid">
             {data.procedures?.map(proc => (
                <a href={`/procedures/${proc.slug}`} class="spoke-card dark-glass">
                   <div class="spoke-info">
                      <h3>{proc.name}</h3>
                      <p>Institutional Technical Spoke</p>
                   </div>
                   <div class="arrow-circle">
                     <ArrowRight size={20} />
                   </div>
                </a>
             ))}
          </div>
       </div>
    </section>

    {/* ══ BOTTOM CTA ══ */}
    <section class="section-block text-center border-t border-light/5">
       <div class="container">
          <Shield size={48} class="text-secondary mb-lg mx-auto" strokeWidth={1} />
          <h2 class="display-xl mb-lg">Referral & Case Governance</h2>
          <p class="body-text max-width-800 mx-auto mb-xl">
             All cases within the {data.h1} are reviewed by the Precision Surgical Board to ensure alignment with our multi-fellowship clinical benchmarks.
          </p>
          <div class="flex-center gap-md">
             <a href="tel:+917842932051" class="btn btn-primary lg">
               Speak with Program Lead <ArrowRight size={16}/>
             </a>
          </div>
       </div>
    </section>
  </div>
</Layout>

<style>
  .l-label {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--secondary);
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .decision-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  
  .decision-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    font-size: 1.1rem;
    color: var(--text-main);
  }

  .tech-icon-circle {
    width: 44px;
    height: 44px;
    background: rgba(6, 182, 212, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .tech-item-mini {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .arrow-circle {
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .spoke-card:hover .arrow-circle {
    background: var(--secondary);
    color: #000;
  }

  .editorial-tag {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: var(--secondary);
    margin-bottom: 1rem;
  }

  .max-width-600 { max-width: 600px; }
  .max-width-800 { max-width: 800px; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .flex-center { display: flex; justify-content: center; align-items: center; }
  .gap-md { gap: 1.5rem; }

  @media (max-width: 768px) {
    .decision-grid { grid-template-columns: 1fr; }
  }
</style>
