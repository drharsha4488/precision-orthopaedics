---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.jsx';
import Footer from '../../components/Footer.jsx';
import { programData } from '../../services/programData';
import { Microscope, ArrowRight, Activity, ShieldCheck } from 'lucide-react';

const programs = Object.entries(programData).map(([slug, data]) => ({
  slug,
  ...data
}));
---

<Layout title="Clinical Programs Directory | Institutional Knowledge Graph">
  <Header client:load />

  <section className="bg-primary text-white py-20 border-b-4 border-secondary">
    <div className="container">
      <h1 className="display-xl">Clinical <span className="text-secondary">Programs</span></h1>
      <p className="hero-subtext max-w-3xl mt-6">
        The authoritative directory of multi-disciplinary surgical programs at Precision Orthopaedics. 
        Each program represents a board-governed clinical ecosystem designed for specific anatomic restoration.
      </p>
    </div>
  </section>

  <section className="py-20 bg-gray-50">
    <div className="container">
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {programs.map((program) => (
          <div className="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow flex flex-col">
            <div className="p-8 flex-grow">
              <div className="flex items-center gap-3 text-secondary mb-4">
                <Microscope size={24} />
                <span className="text-sm font-bold tracking-widest uppercase">Institutional Program</span>
              </div>
              <h3 className="text-2xl font-bold text-primary mb-4">{program.h1}</h3>
              <p className="text-gray-600 line-clamp-3 mb-6">
                {program.doctrine}
              </p>
              
              <div className="space-y-3 mb-8">
                {program.procedures.slice(0, 3).map(proc => (
                  <div className="flex items-center gap-2 text-sm text-gray-500">
                    <ShieldCheck size={14} className="text-secondary" />
                    <span>{proc.name}</span>
                  </div>
                ))}
              </div>
            </div>
            
            <div className="px-8 py-6 bg-gray-50 border-t border-gray-200">
              <a href={`/clinical-programs/${program.slug}`} className="flex items-center justify-between font-bold text-primary hover:text-secondary transition-colors">
                View Full Doctrine <ArrowRight size={20} />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .hero-subtext {
    font-size: 1.25rem;
    color: #E0E1DD;
    line-height: 1.6;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
